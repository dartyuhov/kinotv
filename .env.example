# Optional for fixture checks; needed for real device-code sign-in.
# Copy to .env.local only if it does not exist. Never commit real values.

# Shared app OAuth credentials, NOT your service password or account tokens.
# VITE_* values are embedded in the app bundle and visible to its recipients.
# Configured releases use maintainer-approved borrowed public-client credentials;
# this example supplies no values and makes no ownership/permission claim.
# See CONTRIBUTING.md for provenance and local versus release configuration.
VITE_KP_CLIENT_ID=
VITE_KP_CLIENT_SECRET=

# Optional: another API host, e.g. the mirror https://api.srvkp.com. Default: https://api.service-kp.com
VITE_API_BASE_URL=
