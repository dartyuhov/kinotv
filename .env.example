# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# kino.watch OAuth client for the device sign-in (spec §7.6).
# VITE_* values are embedded in the app bundle and visible to its recipients.
VITE_KP_CLIENT_ID=
VITE_KP_CLIENT_SECRET=

# Optional: another API host, e.g. the mirror https://api.srvkp.com. Default: https://api.service-kp.com
VITE_API_BASE_URL=
