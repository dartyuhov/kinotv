{
  "name": "kinotv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "kinotv": {
    "githubRepo": "OWNER/REPO"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/report-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "package": "npm run build && node tools/tizen/cli.ts package",
    "tv": "node tools/tizen/cli.ts tv",
    "tv:debug": "node tools/tizen/cli.ts tv --debug",
    "tv:setup": "node tools/tizen/cli.ts setup",
    "release:assets": "node tools/release/assemble.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@noriginmedia/norigin-spatial-navigation": "^3.4.0",
    "@tanstack/react-query": "^5.105.1",
    "lucide-react": "^1.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uqr": "^0.1.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
